# Copy to .env and fill in at least one key.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# openai or gemini
DEFAULT_PROVIDER=openai

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_TEMPERATURE=0.2

# Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_HISTORY_TURNS=6

# Limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
MAX_DOCUMENTS=25

DATA_DIR=data

# Login (optional). Passwords can be plain or sha256:<hex>
AUTH_ENABLED=false
APP_USERS=demo:demo123
